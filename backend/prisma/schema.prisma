generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER) // Enum for RBAC
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]   // Relationship: One user can have many tasks
  @@map("users")  // Maps model to "users" table in Postgres
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      Status     @default(PENDING)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relationship: Task belongs to a User
  userId      String
  author      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

enum Role {
  USER
  ADMIN
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}